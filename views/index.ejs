<!DOCTYPE html>
<html lang="ko">

<head>
  <!-- 공통 <head> -->
  <%- include('partials/_head') %>
    <title>RISE UIC x 전시회</title>
    <!-- 전역 스타일 -->
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <!-- 상단 고정: 조회수 뱃지 등 -->
  <%- include('partials/_header', { viewCount: viewCount }) %>

    <div id="slides">
      <!-- 0) 메인 표지 슬라이드 -->
      <div class="slide active">
        <div class="main-card">
          <img class="main-img" src="/images/RISE UIC X 메인.png" alt="메인로고" onerror="this.style.display='none'">
          <h1>RISE UIC X 성과전시회</h1>
          <p style="font-size:1em; font-weight:bold; line-height:1.4; text-align:center;">
            AI SDGs 아이디어톤 <br>
            & <br>
            사회문제해결 리빙랩
          </p>
          <small style="color:#666; font-size:0.8em;">
            청년들이 제안하는 AI 기반 사회문제 해결 솔루션을 만나보세요!
          </small>
          <div class="hashtags">
            <span>#RISE_UIC_X</span>
            <span>#AISDGs</span>
            <span>#AI아이디어톤</span>
            <span>#사회문제해결리빙랩</span>
            <span>#부스체험</span>
          </div>
        </div>
      </div>

      <% /* app.js에서 전달받은 teamTplMap 사용 */ %>

        <!-- 2) 트랙/팀 루프 -->
        <% tracks.forEach(function(track){ %>
          <!-- 트랙 포스터 슬라이드 -->
          <div class="slide">
            <div class="poster-card" style="text-align:center;">
              <img class="poster-img" src="<%= track.poster %>" alt="<%= track.name %> 포스터" 
                   style="display:block;margin:0 auto;max-width:90%;height:auto;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,0.1);"
                   onerror="console.error('포스터 이미지 로드 실패:', this.src); this.style.border='2px solid red';">
              <h2>
                <%= track.name %>
              </h2>
              <% if (track.name.includes('리빙랩')) { %>
                <p style="font-size:0.9em;color:#666;text-align:center;margin-top:15px;line-height:1.5;padding:0 20px;">
                  실생활, 지역사회, 산업 현장 등 우리 주변에서 발생하는 사회문제를 발굴하고,
                  이를 AI 기반 서비스 프로토타입으로 해결하는 프로젝트
                </p>
              <% } %>
              <% if (track.name.includes('아이디어톤')) { %>
                <p style="font-size:0.9em;color:#666;text-align:center;margin-top:15px;line-height:1.5;padding:0 20px;">
                  지속가능발전목표(SDGs)를 기반으로 환경·교육·건강·도시 등
                  다양한 사회문제를 AI 기술로 해결하는 혁신적 아이디어 프로젝트
                </p>
              <% } %>
            </div>
          </div>

          <!-- 트랙 내 팀들 -->
          <% track.teams.forEach(function(team){ %>
            <% const tpl=teamTplMap[team.name]; %>

              <% if (tpl) { %>
                <!-- 팀별 상세 템플릿 include -->
                <%- include('teams/' + tpl, { team: team, track: track }) %>
                  <% } else { %>
                    <!-- 매핑이 없을 때: 공통 팀 카드 (이름/이미지만) -->
                    <div class="slide">
                      <div class="team-card" style="text-align:left;">
                        <div style="font-size:0.97em;color:#276aac;font-weight:bold;margin-bottom:7px;">
                          <%= track.name %>
                        </div>
                        <h3 style="font-size:1.3em;margin-bottom:10px;">
                          <%= team.name %>
                        </h3>
                        <img class="team-img" src="<%= team.image %>" alt="<%= team.name %> 이미지"
                          style="margin-top:2px;height:auto;max-width:100%;border-radius:8px;">
                      </div>
                    </div>
                    <% } %>
                      <% }); %>
                        <% }); %>

                          <!-- 3) 마지막 설문 슬라이드 -->
                          <div class="slide">
                            <div style="text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;">
                              <h2 style="color:#F3F3F3;font-size:1.8em;margin-bottom:30px;margin-top:60px;">설문조사에 참여해 주세요!</h2>
                              <button style="padding:25px 50px !important;font-size:1.5em !important;margin:20px 0 !important;border-radius:12px !important;background:linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;color:white !important;border:none !important;cursor:pointer !important;box-shadow:0 4px 15px rgba(102, 126, 234, 0.4) !important;transition:all 0.3s ease !important;display:block !important;min-width:300px !important;font-weight:bold !important;"
                                onclick="window.open('https://forms.gle/jPiavRptS6faQenx6', '_blank')"
                                onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 20px rgba(102, 126, 234, 0.6)'"
                                onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='0 4px 15px rgba(102, 126, 234, 0.4)'">
                                📝 설문조사 참여하기 📝
                              </button>
                              <p style="margin-top:20px;font-size:14px;color:#ccc;text-align:center;">
                                버튼 클릭 시 새 창에서 설문조사가 시작됩니다.
                              </p>
                            </div>
                          </div>
    </div>

    <!-- 🎉 모던 네비게이션이 JavaScript에서 자동 생성됩니다! -->

    <!-- 공통 스크립트: Swiper, 슬라이드 컨트롤 등 -->
    <%- include('partials/_scripts') %>
</body>

</html>